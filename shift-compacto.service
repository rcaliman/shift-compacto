[Unit]
Description=Shift e barra para teclados compactos
Wants=bluetooth.service
After=bluetooth.service
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/shift-compacto --watch
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
User=root
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
